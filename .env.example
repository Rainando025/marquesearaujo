# ==============================================================================
# Variáveis de Ambiente para Supabase e Vercel (Modelo de Exemplo)
# NUNCA insira chaves reais ou segredos neste arquivo de exemplo.
# No Vercel, configure estas variáveis em: Project Settings -> Environment Variables
# ==============================================================================

# Supabase URL (Projeto no Supabase -> Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_URL="https://seu-projeto.supabase.co"

# Supabase Publishable / Anon Key (Settings -> API -> Project API keys)
VITE_SUPABASE_PUBLISHABLE_KEY="sua_chave_publica_aqui"
SUPABASE_PUBLISHABLE_KEY="sua_chave_publica_aqui"

# Supabase Service Role Key (Settings -> API -> Secret / service_role)
# Mantenha em absoluto sigilo! Usada apenas no servidor para operações administrativas e leads.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_aqui"

# OpenAI API Key (para o assistente de recomendação de imóveis via gpt-4o-mini)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY="sua_openai_api_key_aqui"

# Preset de deploy (Definido automaticamente na Vercel via VERCEL=1)
# NITRO_PRESET="vercel"

